<Window x:Class="SrBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SrBuilder"
        Title="SR Builder" Width="960" Height="640" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Cream}"
        FontFamily="{StaticResource Body}" FontSize="17" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="68" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="StepRowT">
            <Border x:Name="row" Height="30" CornerRadius="15,20,22,13" Padding="8,0" Margin="-8,1" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                        <Ellipse x:Name="dot" Width="11" Height="11" Stroke="{StaticResource Idle}" StrokeThickness="2.2"/>
                        <Path x:Name="check" Data="M3.5,9.5 L7.1,13.1 L14.5,5" Stroke="{StaticResource Mint}" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        <Path x:Name="play" Data="M5,3.5 L14,9 L5,14.5 Z" Fill="{StaticResource Ink}" Visibility="Collapsed"/>
                        <Path x:Name="cross" Data="M4.5,4.5 L13.5,13.5 M13.5,4.5 L4.5,13.5" Stroke="{StaticResource Cream}" StrokeThickness="2.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="txt" Text="{Binding Text}" FontSize="17" Foreground="{StaticResource Cream}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="now">
                    <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="play" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Orange}"/>
                    <Setter TargetName="row" Property="Height" Value="34"/>
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="txt" Property="FontSize" Value="18"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="cross" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Red}"/>
                    <Setter TargetName="row" Property="Height" Value="34"/>
                    <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="txt" Property="FontSize" Value="18"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SegT">
            <Border x:Name="seg" Height="12" Margin="0,0,5,0" CornerRadius="5,7,8,4" Background="{StaticResource Line}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="seg" Property="Background" Value="{StaticResource Mint}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="now">
                    <Setter TargetName="seg" Property="Background" Value="{StaticResource Orange}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter TargetName="seg" Property="Background" Value="{StaticResource Red}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Width="960" Height="640" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- the title bar -->
        <Grid Background="{StaticResource Bar}">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <local:Board Fill="{StaticResource TealBoard}" Padding="16,5,18,7" Shape="0,8 6,0 52,4 97,0 100,46 98,100 44,95 3,100"
                             RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <local:Board.RenderTransform>
                        <RotateTransform Angle="-2"/>
                    </local:Board.RenderTransform>
                    <TextBlock Text="SR BUILDER" FontFamily="{StaticResource Display}" FontSize="24" Foreground="{StaticResource Cream}"
                               Effect="{StaticResource Shadow2}"/>
                </local:Board>
                <TextBlock x:Name="HeaderNote" Margin="18,0,0,0" FontSize="18" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                           Text="Your own game file, made into a folder that plays on this PC"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource Chrome}" Click="Minimize_Click" AutomationProperties.Name="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,4,0">
                    <Path Data="M3,13 L15,13" Stroke="{StaticResource Cream}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource Chrome}" Click="Close_Click" AutomationProperties.Name="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M4,4 L14,14 M14,4 L4,14" Stroke="{StaticResource Cream}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1: setup -->
        <Grid x:Name="SetupView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:Board Fill="{StaticResource Panel}" Padding="18,10,18,12" Margin="0,0,0,12"
                                 Shape="0,3 30,0 71,2 100,0 99.4,52 100,100 62,98 24,100 0.5,97" Tilt="-0.4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Num}" Text="1"/>
                                <TextBlock Style="{StaticResource Head}" Text="GAME FILE" VerticalAlignment="Bottom" Margin="0,0,12,3"/>
                                <TextBlock Style="{StaticResource Note}" Text="A decrypted .nsp, or a .nup, of your own copy" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GameBox" Style="{StaticResource PathBox}" AutomationProperties.Name="Game file" TextChanged="Paths_Changed"/>
                                <Button Grid.Column="2" Style="{StaticResource Blob}" Content="BROWSE" Click="BrowseGame_Click" AutomationProperties.Name="Browse for the game file"/>
                            </Grid>
                            <TextBlock x:Name="GameInfo" Margin="0,6,0,0" FontSize="17" Foreground="{StaticResource Mint}" Text=" "/>
                        </StackPanel>
                    </local:Board>

                    <local:Board Fill="{StaticResource Panel}" Padding="18,10,18,12" Margin="0,0,0,12"
                                 Shape="0.4,0 38,2.5 80,0 100,3 99.5,60 100,98 55,100 20,97.5 0,100" Tilt="0.3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Num}" Text="2"/>
                                <TextBlock Style="{StaticResource Head}" Text="FIRMWARE AND KEYS" VerticalAlignment="Bottom" Margin="0,0,12,3"/>
                                <TextBlock Style="{StaticResource Note}" Text="First build only" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Firmware folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="FirmwareBox" Grid.Column="1" Style="{StaticResource PathBox}" AutomationProperties.Name="Firmware folder" TextChanged="Paths_Changed"/>
                                <Button Grid.Column="3" Style="{StaticResource Blob}" Content="BROWSE" Click="BrowseFirmware_Click" AutomationProperties.Name="Browse for the firmware folder"/>
                                <TextBlock Grid.Row="2" Text="prod.keys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="KeysBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PathBox}" AutomationProperties.Name="prod.keys file" TextChanged="Paths_Changed"/>
                                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource Blob}" Content="BROWSE" Click="BrowseKeys_Click" AutomationProperties.Name="Browse for prod.keys"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" FontSize="17" Foreground="{StaticResource Amber}"
                                       Text="Read once, for the system fonts. Nothing of them is kept."/>
                        </StackPanel>
                    </local:Board>

                    <local:Board Fill="{StaticResource Panel}" Padding="18,10,18,12"
                                 Shape="0,2.5 26,0 66,3 99.6,0 100,50 99.3,100 70,97.5 33,100 0.4,98" Tilt="-0.3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Num}" Text="3"/>
                                <TextBlock Style="{StaticResource Head}" Text="GAME FOLDER" VerticalAlignment="Bottom" Margin="0,0,12,3"/>
                                <TextBlock Style="{StaticResource Note}" Text="Where the game will live. You can move it later." VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DestBox" Style="{StaticResource PathBox}" AutomationProperties.Name="Game folder" TextChanged="Paths_Changed"/>
                                <Button Grid.Column="2" Style="{StaticResource Blob}" Content="BROWSE" Click="BrowseDest_Click" AutomationProperties.Name="Browse for the game folder"/>
                            </Grid>
                            <TextBlock x:Name="DestInfo" Style="{StaticResource Note}" Margin="0,6,0,0" Text=" "/>
                        </StackPanel>
                    </local:Board>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <local:Board Fill="{StaticResource Bar}" Padding="16,14,16,10" Margin="0,0,0,12"
                                 Shape="0,1.5 48,0 100,2 99,55 100,100 45,98.5 0.8,100" Tilt="0.6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="WHEN IT IS DONE" Margin="0,0,0,4"/>
                            <CheckBox x:Name="DesktopBox" Style="{StaticResource Tick}" Content="Shortcut on the desktop"/>
                            <CheckBox x:Name="StartMenuBox" Style="{StaticResource Tick}" Content="Shortcut in the Start menu"/>
                            <CheckBox x:Name="DeleteBox" Style="{StaticResource Tick}" Content="Remove the original game file"/>
                            <TextBlock x:Name="DeleteNote" Style="{StaticResource Note}" FontSize="15" Margin="34,0,0,6"
                                       Text="Only after checking that the folder rebuilds it exactly. It goes to the Recycle Bin."/>
                        </StackPanel>
                    </local:Board>
                    <local:Board Fill="{StaticResource Bar}" Padding="16,14,16,14"
                                 Shape="0.6,0 52,2 99.4,0 100,48 99,100 50,98 0,100" Tilt="-0.5">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Head}" Text="WHAT HAPPENS"/>
                            <TextBlock FontSize="17" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="A dozen steps, mostly compiling and preparing shaders. It took about 7 minutes on the PC it was tested on."/>
                            <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                       Text="Stop whenever you like: the next build carries on from the last finished step."/>
                            <TextBlock x:Name="ToolsNote" FontSize="17" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Amber}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </local:Board>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="22,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Link}" Content="Restore an original from a game folder…" Click="Restore_Click" VerticalAlignment="Center"/>
                <TextBlock x:Name="SetupMessage" Grid.Column="1" Margin="18,0,18,0" FontSize="17" Foreground="{StaticResource Amber}"
                           TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
                <Button x:Name="BuildButton" Grid.Column="2" Style="{StaticResource BlobBig}" Content="BUILD" Click="Build_Click"
                        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,6,0">
                    <Button.RenderTransform>
                        <RotateTransform Angle="-1.5"/>
                    </Button.RenderTransform>
                </Button>
            </Grid>
        </Grid>

        <!-- 2 and 4: building, and a step that failed or was stopped -->
        <Grid x:Name="BuildView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="372"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:Board Fill="{StaticResource Panel}" Padding="16,14,16,14" VerticalAlignment="Top"
                             Shape="0,1 45,0 100,1.5 99.2,50 100,100 52,99 0.6,100" Tilt="-0.4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Head}" Text="THE STEPS"/>
                        <ItemsControl x:Name="StepsList" ItemTemplate="{StaticResource StepRowT}" Margin="0,8,0,0" Focusable="False"/>
                    </StackPanel>
                </local:Board>
                <StackPanel Grid.Column="2" Margin="0,8,0,0">
                    <TextBlock x:Name="StepCount" Style="{StaticResource Head}" Foreground="{StaticResource Amber}" Text="STEP 1 OF 11"/>
                    <TextBlock x:Name="StepTitle" FontFamily="{StaticResource Display}" FontSize="32" TextWrapping="Wrap" Margin="0,12,0,0"
                               Effect="{StaticResource Shadow2}" RenderTransformOrigin="0,0.5" LineHeight="36" LineStackingStrategy="BlockLineHeight">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <StackPanel x:Name="ProgressPanel" Margin="0,22,0,0">
                        <Grid>
                            <TextBlock x:Name="PhaseText" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AmountText" FontSize="19" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="34" Margin="0,8,0,0" Background="{StaticResource Deep}" BorderBrush="{StaticResource Line}" BorderThickness="2"
                                CornerRadius="16,22,24,15" AutomationProperties.Name="This step">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="FillCol" Width="0*"/>
                                    <ColumnDefinition x:Name="RestCol" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="FillBar" Background="{StaticResource Orange}" CornerRadius="14,16,20,13">
                                    <TextBlock x:Name="PercentText" FontFamily="{StaticResource Display}" FontSize="17" Foreground="{StaticResource Ink}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Border>
                                <Canvas x:Name="Drops" Grid.Column="1" ClipToBounds="True">
                                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="9" Height="9" Fill="{StaticResource Orange}"/>
                                    <Ellipse Canvas.Left="17" Canvas.Top="18" Width="5" Height="5" Fill="{StaticResource Orange}"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <Grid Margin="0,20,0,0">
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="The whole build"/>
                            <TextBlock x:Name="ElapsedText" FontSize="19" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="SegList" ItemTemplate="{StaticResource SegT}" Margin="0,8,-5,0" Focusable="False"
                                      AutomationProperties.Name="The whole build">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <local:Board x:Name="ErrorBoard" Fill="{StaticResource Red}" Padding="18,14,18,16" Margin="0,22,0,0" Visibility="Collapsed" Shape="0,3 40,0 100,3.5 99.4,100 55,96.5 0.5,100" Tilt="0.5">
                        <StackPanel>
                            <TextBlock x:Name="ErrorHead" Style="{StaticResource Head}" FontSize="17" Text="WHAT WENT WRONG"/>
                            <TextBlock x:Name="ErrorText" FontSize="19" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </local:Board>

                    <local:Board x:Name="NoteBoard" Fill="{StaticResource Bar}" Padding="16,12,16,12" Margin="0,18,0,0"
                                 Shape="0,3 50,0 100,4 99.3,100 48,96 0.5,100" Tilt="0.4">
                        <TextBlock x:Name="BuildNote" FontSize="17" TextWrapping="Wrap"/>
                    </local:Board>
                </StackPanel>
            </Grid>
            <Grid x:Name="RunningFooter" Grid.Row="1" Margin="22,0,22,0">
                <Button Style="{StaticResource Link}" Content="Open the log" Click="OpenLog_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Note}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                               Text="Stopping keeps what is done.&#10;The next build carries on from here."/>
                    <Button x:Name="StopButton" Style="{StaticResource BlobOutline}" Content="STOP" Click="Stop_Click"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="StoppedFooter" Grid.Row="1" Margin="22,0,22,0" Visibility="Collapsed">
                <Button Style="{StaticResource Link}" Content="Back to the setup" Click="BackToSetup_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BlobMid}" Content="OPEN THE LOG" Click="OpenLog_Click" Margin="0,0,18,0" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <RotateTransform Angle="1"/>
                        </Button.RenderTransform>
                    </Button>
                    <Button x:Name="RetryButton" Style="{StaticResource BlobBig}" FontSize="24" Content="TRY AGAIN" Click="Retry_Click"
                            RenderTransformOrigin="0.5,0.5" Margin="0,0,6,0">
                        <Button.RenderTransform>
                            <RotateTransform Angle="-1.5"/>
                        </Button.RenderTransform>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3: done -->
        <Grid x:Name="DoneView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="60,30,60,0">
                <local:Board Fill="{StaticResource GreenBoard}" Padding="30,8,34,12" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                             Shape="0,6 22,0 60,5 98,0 100,52 98.5,100 58,94 20,100 1,95">
                    <local:Board.RenderTransform>
                        <RotateTransform Angle="-2.5"/>
                    </local:Board.RenderTransform>
                    <TextBlock x:Name="DoneTitle" Text="READY TO PLAY" FontFamily="{StaticResource Display}" FontSize="46"
                               Foreground="{StaticResource Cream}" Effect="{StaticResource Shadow4}"/>
                </local:Board>
                <local:Board Fill="{StaticResource Panel}" Padding="24,18,24,18" Margin="0,24,0,0"
                             Shape="0,2 35,0 74,2.5 100,0 99.5,55 100,100 60,98 25,100 0.4,97.5" Tilt="0.3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="L1" Style="{StaticResource Head}" FontSize="15" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="V1" Grid.Column="1" FontSize="19" TextWrapping="Wrap"/>
                        <TextBlock x:Name="L2" Grid.Row="2" Style="{StaticResource Head}" FontSize="15" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="V2" Grid.Row="2" Grid.Column="1" FontSize="19" TextWrapping="Wrap"/>
                        <TextBlock x:Name="L3" Grid.Row="4" Style="{StaticResource Head}" FontSize="15" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="V3" Grid.Row="4" Grid.Column="1" FontSize="19" TextWrapping="Wrap"/>
                    </Grid>
                </local:Board>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource BlobBig}" FontSize="30" Height="68" Padding="52,0,56,2" Content="PLAY"
                            Click="Play_Click" RenderTransformOrigin="0.5,0.5" Margin="0,0,22,0">
                        <Button.RenderTransform>
                            <RotateTransform Angle="-1.5"/>
                        </Button.RenderTransform>
                    </Button>
                    <Button x:Name="OpenFolderButton" Style="{StaticResource BlobMid}" Content="OPEN THE FOLDER" Click="OpenFolder_Click"
                            RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <Button.RenderTransform>
                            <RotateTransform Angle="1"/>
                        </Button.RenderTransform>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="DoneNote" Style="{StaticResource Note}" FontSize="17" TextAlignment="Center" Margin="40,22,40,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="22,0,22,0">
                <Button x:Name="DoneRestoreLink" Style="{StaticResource Link}" Content="Restore the original from this folder…" Click="RestoreFromDone_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Link}" Content="Back to the setup" Click="BackToSetup_Click" Margin="0,0,18,0"/>
                    <Button Style="{StaticResource Link}" Content="Open the log" Click="OpenLog_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
