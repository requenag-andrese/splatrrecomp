<Project Sdk="Microsoft.NET.Sdk">
  <!-- SR Builder's window (phase 2): runs `python -m builder` and shows its JSON events. Build:
       <workspace>/.toolchains/dotnet/dotnet.exe build builder/window -c Release
       Fonts: fonts/*.ttf (Bowlby One, Barlow Condensed; both OFL, licences beside them) are built in; App.xaml names
       Impact and Bahnschrift Condensed, which ship with Windows, as the fallback. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SrBuilder</AssemblyName>
    <RootNamespace>SrBuilder</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>
</Project>
