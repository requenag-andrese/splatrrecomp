+// sr-recomp: NVIDIA's texture units sample a NaN coordinate as 0; PC drivers return anything (black ink in
+// Splatoon Raiders). As Ryujinx's SPIR-V back end in nx2android PR #88: NaN components become 0.
+static Id NanToZero(EmitContext& ctx, const IR::TextureInstInfo& info, Id coords) {
+    int n = 2;
+    switch (info.type) {
+    case TextureType::Color1D:
+    case TextureType::Buffer:
+        n = 1;
+        break;
+    case TextureType::ColorArray2D:
+    case TextureType::Color3D:
+    case TextureType::ColorCube:
+        n = 3;
+        break;
+    case TextureType::ColorArrayCube:
+        n = 4;
+        break;
+    default:
+        break;
+    }
+    if (n == 1) {
+        return ctx.OpSelect(ctx.F32[1], ctx.OpIsNan(ctx.U1, coords), ctx.f32_zero_value, coords);
+    }
+    const Id zero{ctx.f32_zero_value};
+    const Id zeros[4]{zero, zero, zero, zero};
+    const Id zvec{ctx.ConstantComposite(ctx.F32[n], std::span<const Id>(zeros, n))};
+    return ctx.OpSelect(ctx.F32[n], ctx.OpIsNan(ctx.TypeVector(ctx.U1, n), coords), zvec, coords);
+}
